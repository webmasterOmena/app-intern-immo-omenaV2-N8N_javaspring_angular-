# Optional local overrides. The stack starts without this file.
TZ=Europe/Paris

WEB_PORT=4200
API_PORT=8080
N8N_PUBLIC_PORT=5679

IMMO_DB_NAME=immo
IMMO_DB_USER=immo
IMMO_DB_PASSWORD=immo-local-change-me

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n-local-change-me

N8N_VERSION=stable
N8N_ENCRYPTION_KEY=local-development-key-change-before-production

